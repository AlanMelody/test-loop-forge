# 复制为 .env 后填入本地值；示例值均为占位符，禁止用于生产环境。
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>

# 会话
SESSION_COOKIE_NAME=lf_session
SESSION_TTL_SECONDS=28800

# AI 草稿适配器：首版仅 deterministic，后续可替换为真实模型适配器
AI_ADAPTER=deterministic

# 四固定账号初始化（npm run seed）。占位符会被 seed 拒绝；请使用各环境自己的强密码。
SEED_PM_USERNAME=pm
SEED_PM_PASSWORD=<set-a-strong-password-for-pm>
SEED_BACKEND_USERNAME=backend
SEED_BACKEND_PASSWORD=<set-a-strong-password-for-backend>
SEED_FRONTEND_USERNAME=frontend
SEED_FRONTEND_PASSWORD=<set-a-strong-password-for-frontend>
SEED_TEST_USERNAME=test
SEED_TEST_PASSWORD=<set-a-strong-password-for-test>
